{
  "name": "cn-divisions",
  "version": "0.1.3",
  "description": "China administrative divisions dataset — 43,000+ entries across province / city / county / township levels with pinyin, plus a typed lookup API. Zero runtime dependencies. 中国行政区划数据(省、市、区县、乡镇街道四级,含拼音),附 TypeScript 查询 API。",
  "keywords": [
    "china",
    "chinese",
    "divisions",
    "administrative-divisions",
    "regions",
    "pinyin",
    "行政区划",
    "省",
    "市",
    "区县",
    "乡镇",
    "街道"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roy-tian/cn-divisions.git"
  },
  "bugs": {
    "url": "https://github.com/roy-tian/cn-divisions/issues"
  },
  "homepage": "https://github.com/roy-tian/cn-divisions#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=23.6.0"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data/*": "./data/*",
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "sql",
    "README.md",
    "README_zh.md",
    "NOTICE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "import:seed": "node scripts/import-seed.ts",
    "generate:sql": "node scripts/generate-sql.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  }
}
